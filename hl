def main():
    # Проверяем первый запуск
    if not os.path.exists(CONFIG_FILE):
        first_run()
        show_welcome()
        return
    
    # Проверяем аргументы
    if len(sys.argv) < 2:
        show_welcome()
        return
    
    command = sys.argv[1]
    
    if command == "scan":
        if len(sys.argv) < 3:
            print(f"{Colors.RED}❌ Укажите цель для сканирования{Colors.END}")
            print(f"{Colors.YELLOW}Пример: hl scan scanme.nmap.org{Colors.END}")
            return
        
        target = sys.argv[2]
        tool_name = None
        
        # Проверяем наличие --tool
        if "--tool" in sys.argv:
            tool_index = sys.argv.index("--tool")
            if tool_index + 1 < len(sys.argv):
                tool_name = sys.argv[tool_index + 1]
        
        cmd_scan(target, tool_name)
    
    elif command == "dashboard":
        cmd_dashboard()
    
    elif command == "mode":
        if len(sys.argv) < 3:
            print(f"{Colors.RED}❌ Укажите режим: beginner или professional{Colors.END}")
            return
        cmd_mode(sys.argv[2])
    
    elif command == "tools":
        cmd_tools()
    
    elif command == "level":
        config = load_config()
        level = config.get("level", 1)
        xp = config.get("xp", 0)
        print(f"{Colors.CYAN}🎮 Ваш уровень: {level}{Colors.END}")
        print(f"{Colors.YELLOW}⭐ XP: {xp}{Colors.END}")
        
        if config.get("mode") == "beginner" and level < 10:
            xp_needed = [0, 100, 250, 500, 850, 1300, 1850, 2500, 3250, 4100]
            needed = xp_needed[level] - xp
            print(f"{Colors.GREEN}📈 До следующего уровня нужно: {needed} XP{Colors.END}")
    
    elif command == "learn":
        cmd_learn()
    
    elif command == "analyze":
        cmd_analyze()
    
    elif command == "lab":
        cmd_lab()

    elif command == "report":
        cmd_report()

    elif command == "premium":
        cmd_premium()
    
    elif command == "help":
        cmd_help()
    
    else:
        print(f"{Colors.RED}❌ Команда '{command}' не найдена{Colors.END}")
        cmd_help()

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print(f"\n{Colors.YELLOW}👋 Выход из HackLab Manager{Colors.END}")
        sys.exit(0)
    except Exception as e:
        print(f"{Colors.RED}❌ Критическая ошибка: {e}{Colors.END}")
