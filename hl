        try:
            sys.path.insert(0, BASE_DIR)
            from core.analyzer import ThinkingAnalyzer
            from reports.generator import PDFGenerator            
            analyzer = ThinkingAnalyzer()
            analysis = analyzer.analyze_sequence(lab_id=int(lab_id))
            sequence = analyzer.get_actions(lab_id=int(lab_id))

            config = load_config()
            username = config.get('username', 'hacker')

