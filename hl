def load_tool_module(tool_name):
    
    tool_path = os.path.join(TOOLS_DIR, f"{tool_name}.py")
    
    if not os.path.exists(tool_path):
        print(f"{Colors.RED}❌ Инструмент '{tool_name}' не найден{Colors.END}")
        print(f"{Colors.YELLOW}💡 Файл должен быть: {tool_path}{Colors.END}")
        return None
    
    try:
        # Добавляем директорию tools в sys.path
        sys.path.insert(0, TOOLS_DIR)
        
        # Импортируем модуль
        module_name = tool_name
        spec = importlib.util.spec_from_file_location(module_name, tool_path)
        module = importlib.util.module_from_spec(spec)
        
        # Выполняем модуль
        spec.loader.exec_module(module)
        
        func_names = ['run', 'scan', f'scan_{tool_name}', 
              'get_network_info', 'scan_ports', 'check_ssl', 'whois_lookup',
              'scan_website', 'scan_directories', 'find_subdomains',
              'test_sql_injection', 'scan_xss', 'fuzz_api']
        
        for func_name in func_names:
            if hasattr(module, func_name):
                func = getattr(module, func_name)
                if callable(func):
                    return func
        
        # Если не нашли, возвращаем модуль
        print(f"{Colors.YELLOW}⚠️  Не найдена функция, возвращаю модуль{Colors.END}")
        return module
            
    except Exception as e:
        print(f"{Colors.RED}❌ Ошибка загрузки инструмента {tool_name}: {e}{Colors.END}")
        import traceback
        traceback.print_exc()
        return None

def cmd_scan(target, tool_name=None):
    
    try:
        from core.action_logger import logger
        has_logger = True
    except:
        has_logger = False

    config = load_config()
    mode = config.get("mode", "beginner")
    level = config.get("level", 1)
    unlocked_tools = config.get("unlocked_tools", [])
    
    # Безопасные цели для новичков
    safe_targets = ["scanme.nmap.org", "example.com", "8.8.8.8", "1.1.1.1", "127.0.0.1"]
    
    if mode == "beginner" and target not in safe_targets:
        print(f"{Colors.RED}❌ В режиме Новичка разрешены только безопасные цели:{Colors.END}")
        for t in safe_targets:
            print(f"   • {t}")
        print()
        print(f"{Colors.YELLOW}💡 Используйте: hl mode professional для других целей{Colors.END}")
        return
    
    if tool_name:
        # Проверяем доступность инструмента
        if tool_name not in unlocked_tools:
            print(f"{Colors.RED}❌ Инструмент '{tool_name}' не разблокирован{Colors.END}")
            
            # Показываем, на каком уровне разблокируется
            tool_levels = {
                "network_info": 1, "port_check": 1,
                "web_scanner": 2, "ssl_checker": 3,
                "whois_checker": 4, "dir_buster": 5,
                "subdomain_scanner": 6, "cve_lookup": 7,
                "hash_cracker": 8, "sql_tester": 9,
                "xss_scanner": 10, "api_fuzzer": 10
            }
            
            if tool_name in tool_levels:
                req_level = tool_levels[tool_name]
                print(f"   📊 Разблокируется на уровне: {req_level}")
                print(f"   📈 Ваш уровень: {level}")
            
            return
        
        # Загружаем и запускаем инструмент
        print(f"\n{Colors.BLUE}🛠️  Запускаю {tool_name.replace('_', ' ').title()}...{Colors.END}")
        tool = load_tool_module(tool_name)
        
        if tool:
            try:
                result = tool(target)
                
                if has_logger:
                    try:
                        logger.log_action(
                            user_id=1,
                            lab_id=config.get("current_lab", 1),
                            action_type=tool_name + "_scan",
                            tool_used=tool_name,
                            target=target,
                            result=str(result)[:100]  # первые 100 символов
                        )
                        print(f"{Colors.GREEN}📝 Действие записано в журнал{Colors.END}")
                    except Exception as log_e:
                        print(f"{Colors.YELLOW}⚠️  Не удалось записать лог: {log_e}{Colors.END}")
                
                # Добавляем XP
                if mode == "beginner":
                    old_level = config.get("level", 1)
                    config["xp"] = config.get("xp", 0) + 25
                    config = check_level_up(config)
                    save_config(config)
                    
                    print(f"\n{Colors.GREEN}✨ +25 XP получено!{Colors.END}")
                    
                    if config.get("level", 1) > old_level:
                        print(f"{Colors.GREEN}🏆 Уровень повышен!{Colors.END}")
                
            except Exception as e:
                print(f"{Colors.RED}❌ Ошибка выполнения инструмента: {e}{Colors.END}")
                import traceback
                traceback.print_exc()
        else:
            print(f"{Colors.RED}❌ Не удалось загрузить инструмент {tool_name}{Colors.END}")
    
    else:
        # Автоматический выбор инструмента
        print(f"\n{Colors.BLUE}🎯 Сканирование цели: {target}{Colors.END}")
        
        # Показываем доступные инструменты
        print(f"{Colors.CYAN}🔧 Доступные инструменты:{Colors.END}")
        available = []
        for tool in unlocked_tools:
            tool_display = tool.replace("_", " ").title()
            print(f"   • {tool_display} ({tool})")
            available.append(tool)
        
        if not available:
            print(f"{Colors.YELLOW}⚠️  Нет доступных инструментов{Colors.END}")
            print(f"{Colors.YELLOW}💡 Начните с: hl learn{Colors.END}")
            return
        
        # Спросим пользователя
        print(f"\n{Colors.YELLOW}Выберите инструмент (или нажмите Enter для network_info):{Colors.END}")
        choice = input(f"{Colors.CYAN}> {Colors.END}").strip().lower()
        
        if choice == "":
            choice = "network_info"
        
        if choice in available:
            cmd_scan(target, choice)
        else:
            print(f"{Colors.RED}❌ Инструмент не доступен{Colors.END}")
            print(f"{Colors.YELLOW}💡 Используйте: hl scan {target} --tool [имя]{Colors.END}")

